  background: var(--bg-bg-brand-disabled, rgba(75, 63, 227, 0.22)) !important;
  color: var(--icon-icon-brand, #4b3fe3) !important;
  font-weight: bold !important;
}

.trae-edit-toolbar-button-active:hover {
  background: var(--bg-bg-brand-popup, rgba(170, 183, 255, 0.36)) !important;
}

