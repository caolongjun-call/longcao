            display: flex;
            align-items: center;
            justify-content: center;
            margin-top: 4px;
        }
        .retry-btn {
            padding: 6px 16px;
            font-size: 13px;
            font-weight: 500;
            color: var(--trae-text-secondary);
            background: var(--trae-bg-overlay-l2);
